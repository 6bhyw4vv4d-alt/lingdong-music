#!/usr/bin/osascript -l JavaScript

ObjC.import("Cocoa");
ObjC.import("Foundation");
ObjC.import("AppKit");

var app = Application.currentApplication();
app.includeStandardAdditions = true;

var PRODUCT_NAME = "灵动音乐";
var PRODUCT_VERSION = "0.2.0-beta.2";
var BUNDLE_IDENTIFIER = "com.lingdongmusic.desktop";
var LRCLIB_BASE_URL = "https://lrclib.net/api";
var USER_AGENT = "Lingdong-Music/" + PRODUCT_VERSION + " (macOS JXA beta)";
var PROJECT_ROOT = "";
var LEGACY_DATA_ROOT = "";
var DATA_ROOT = "";
var OVERRIDES_PATH = "";
var SETTINGS_PATH = "";

var state = {
  window: null,
  statusItem: null,
  visibilityMenuItem: null,
  titleLabel: null,
  lyricLabel: null,
  translationLabel: null,
  statusButton: null,
  controller: null,
  correctionPanel: null,
  fields: {},
  candidatePopup: null,
  manualCandidates: [],
  currentMeta: null,
  currentKey: "",
  currentLyrics: [],
  currentLyricsSource: "",
  currentLrclibId: "",
  currentOffsetSeconds: 0,
  lastDisplayLine: "",
  lastLookupKey: "",
  lastError: "",
  overrides: null,
  settings: null
};

function run(argv) {
  initializeRuntimePaths();
  if (!activateExistingInstanceOrContinue()) {
    return;
  }
  if (hasArgument(argv, "--self-test")) {
    runSelfTest();
    return;
  }
  if (hasArgument(argv, "--ui-smoke")) {
    runUiSmokeTest();
    return;
  }
  if (hasArgument(argv, "--lrclib-smoke")) {
    runLrclibSmokeTest();
    return;
  }
  if (hasArgument(argv, "--music-smoke")) {
    runMusicSmokeTest();
    return;
  }

  ensureDataFiles();
  state.overrides = loadOverrides();
  state.settings = loadSettings();
  startApp();
}

function activateExistingInstanceOrContinue() {
  try {
    var bundleIdentifier = ObjC.unwrap($.NSBundle.mainBundle.bundleIdentifier);
    if (bundleIdentifier !== BUNDLE_IDENTIFIER) {
      return true;
    }

    var currentPid = toNumber($.NSProcessInfo.processInfo.processIdentifier);
    var runningApps = $.NSRunningApplication.runningApplicationsWithBundleIdentifier(
      $(BUNDLE_IDENTIFIER)
    );
    for (var i = 0; i < runningApps.count; i++) {
      var candidate = runningApps.objectAtIndex(i);
      if (toNumber(candidate.processIdentifier) !== currentPid) {
        candidate.activateWithOptions($.NSApplicationActivateIgnoringOtherApps);
        return false;
      }
    }
  } catch (_error) {
  }
  return true;
}

function initializeRuntimePaths() {
  PROJECT_ROOT = ObjC.unwrap($.NSFileManager.defaultManager.currentDirectoryPath);
  LEGACY_DATA_ROOT = PROJECT_ROOT + "/data";

  var configuredDataRoot = environmentValue("LINGDONG_MUSIC_DATA_DIR");
  var applicationSupportPaths = $.NSSearchPathForDirectoriesInDomains(
    $.NSApplicationSupportDirectory,
    $.NSUserDomainMask,
    true
  );
  var applicationSupport = ObjC.unwrap(applicationSupportPaths.objectAtIndex(0));
  DATA_ROOT = configuredDataRoot || applicationSupport + "/" + PRODUCT_NAME;
  OVERRIDES_PATH = DATA_ROOT + "/overrides.json";
  SETTINGS_PATH = DATA_ROOT + "/settings.json";
}

function hasArgument(argv, expected) {
  if (!argv) {
    return false;
  }
  try {
    if (typeof argv.indexOf === "function") {
      return argv.indexOf(expected) >= 0;
    }
  } catch (_error) {
  }
  try {
    var length = toNumber(argv.length);
    for (var i = 0; i < length; i++) {
      if (String(argv[i]) === expected) {
        return true;
      }
    }
  } catch (_error2) {
  }
  return false;
}

function ensureDataFiles() {
  var fm = $.NSFileManager.defaultManager;
  fm.createDirectoryAtPathWithIntermediateDirectoriesAttributesError(
    $(DATA_ROOT),
    true,
    $.NSDictionary.dictionary,
    null
  );
  migrateLegacyDataFile("overrides.json");
  migrateLegacyDataFile("settings.json");
  if (!fm.fileExistsAtPath($(OVERRIDES_PATH))) {
    writeTextFile(OVERRIDES_PATH, JSON.stringify({ version: 1, tracks: {} }, null, 2) + "\n");
  }
  if (!fm.fileExistsAtPath($(SETTINGS_PATH))) {
    writeTextFile(SETTINGS_PATH, JSON.stringify(defaultSettings(), null, 2) + "\n");
  }
}

function environmentValue(name) {
  try {
    var value = $.NSProcessInfo.processInfo.environment.objectForKey($(name));
    var unwrapped = ObjC.unwrap(value);
    if (unwrapped === null || unwrapped === undefined) {
      return "";
    }
    var text = String(unwrapped).trim();
    return text === "undefined" || text === "null" ? "" : text;
  } catch (_error) {
    return "";
  }
}

function migrateLegacyDataFile(filename) {
  if (environmentValue("LINGDONG_MUSIC_DATA_DIR")) {
    return;
  }
  var fm = $.NSFileManager.defaultManager;
  var source = LEGACY_DATA_ROOT + "/" + filename;
  var destination = DATA_ROOT + "/" + filename;
  if (source === destination ||
    !fm.fileExistsAtPath($(source)) ||
    fm.fileExistsAtPath($(destination))) {
    return;
  }
  fm.copyItemAtPathToPathError($(source), $(destination), null);
}

function defaultSettings() {
  return {
    version: 1,
    lyricFontSize: 20,
    lyricColorHex: "#FFFFFF"
  };
}

function loadOverrides() {
  try {
    var text = readTextFile(OVERRIDES_PATH);
    var parsed = JSON.parse(text);
    if (!parsed || parsed.version !== 1 || !parsed.tracks) {
      return { version: 1, tracks: {} };
    }
    return parsed;
  } catch (error) {
    return { version: 1, tracks: {} };
  }
}

function saveOverrides() {
  ensureDataFiles();
  writeTextFile(OVERRIDES_PATH, JSON.stringify(state.overrides, null, 2) + "\n");
}

function loadSettings() {
  try {
    var parsed = JSON.parse(readTextFile(SETTINGS_PATH));
    return normalizeSettings(parsed);
  } catch (_error) {
    return defaultSettings();
  }
}

function saveSettings() {
  ensureDataFiles();
  state.settings = normalizeSettings(state.settings);
  writeTextFile(SETTINGS_PATH, JSON.stringify(state.settings, null, 2) + "\n");
}

function normalizeSettings(settings) {
  var defaults = defaultSettings();
  var incoming = settings || {};
  return {
    version: 1,
    lyricFontSize: clampLyricFontSize(incoming.lyricFontSize || defaults.lyricFontSize),
    lyricColorHex: normalizeHexColor(incoming.lyricColorHex || defaults.lyricColorHex)
  };
}

function clampLyricFontSize(value) {
  var size = Math.round(toNumber(value));
  if (!size) {
    size = defaultSettings().lyricFontSize;
  }
  if (size < 14) {
    return 14;
  }
  if (size > 30) {
    return 30;
  }
  return size;
}

function normalizeHexColor(value) {
  var text = String(value || "").trim();
  if (text.charAt(0) !== "#") {
    text = "#" + text;
  }
  if (/^#[0-9a-fA-F]{3}$/.test(text)) {
    text = "#" + text.charAt(1) + text.charAt(1) +
      text.charAt(2) + text.charAt(2) +
      text.charAt(3) + text.charAt(3);
  }
  if (!/^#[0-9a-fA-F]{6}$/.test(text)) {
    return defaultSettings().lyricColorHex;
  }
  return text.toUpperCase();
}

function nsColorFromHex(value) {
  var hex = normalizeHexColor(value).substring(1);
  var red = parseInt(hex.substring(0, 2), 16) / 255;
  var green = parseInt(hex.substring(2, 4), 16) / 255;
  var blue = parseInt(hex.substring(4, 6), 16) / 255;
  return $.NSColor.colorWithCalibratedRedGreenBlueAlpha(red, green, blue, 1);
}

function readTextFile(path) {
  var text = $.NSString.stringWithContentsOfFileEncodingError(
    $(path),
    $.NSUTF8StringEncoding,
    null
  );
  if (!text) {
    return "";
  }
  return ObjC.unwrap(text);
}

function writeTextFile(path, text) {
  var nsText = $.NSString.alloc.initWithUTF8String(text);
  nsText.writeToFileAtomicallyEncodingError($(path), true, $.NSUTF8StringEncoding, null);
}

function startApp() {
  var nsApp = $.NSApplication.sharedApplication;
  nsApp.setActivationPolicy($.NSApplicationActivationPolicyAccessory);

  registerControllerClass();
  state.controller = $.LyricIslandController.alloc.init;

  createIslandWindow();
  createStatusMenu();
  renderStatus("等待 Music.app", "打开 Music.app 播放歌曲后会自动匹配歌词");

  $.NSTimer.scheduledTimerWithTimeIntervalTargetSelectorUserInfoRepeats(
    1.0,
    state.controller,
    "tick:",
    null,
    true
  );

  nsApp.run;
}

function registerControllerClass() {
  ObjC.registerSubclass({
    name: "LyricIslandController",
    methods: {
      "tick:": {
        types: ["void", ["id"]],
        implementation: function(_timer) {
          pollAndRender();
        }
      },
      "openCorrection:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          openCorrectionPanel();
        }
      },
      "advanceLyrics:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          adjustCurrentOffset(0.5);
        }
      },
      "resetLyricsOffset:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          setCurrentOffset(0);
        }
      },
      "delayLyrics:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          adjustCurrentOffset(-0.5);
        }
      },
      "toggleIsland:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          toggleIslandVisibility();
        }
      },
      "openAutomationSettings:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          openAutomationSettings();
        }
      },
      "showAbout:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          showAboutDialog();
        }
      },
      "quitApp:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          $.NSApplication.sharedApplication.terminate(null);
        }
      },
      "searchCandidates:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          searchManualCandidates();
        }
      },
      "saveCorrection:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          saveCorrection();
        }
      },
      "saveDisplaySettings:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          saveDisplaySettingsOnly();
        }
      },
      "cancelCorrection:": {
        types: ["void", ["id"]],
        implementation: function(_sender) {
          closeCorrectionPanel();
        }
      }
    }
  });
}

function createIslandWindow() {
  var width = 620;
  var height = 104;
  var screenFrame = getVisibleScreenFrame();
  var x = screenFrame.origin.x + (screenFrame.size.width - width) / 2;
  var y = screenFrame.origin.y + screenFrame.size.height - height - 16;
  var frame = $.NSMakeRect(x, y, width, height);

  var window = $.NSWindow.alloc.initWithContentRectStyleMaskBackingDefer(
    frame,
    $.NSWindowStyleMaskBorderless,
    $.NSBackingStoreBuffered,
    false
  );
  window.setOpaque(false);
  window.setBackgroundColor($.NSColor.clearColor);
  window.setLevel($.NSFloatingWindowLevel);
  window.setMovableByWindowBackground(true);
  window.setHasShadow(true);
  window.setCollectionBehavior($.NSWindowCollectionBehaviorCanJoinAllSpaces);

  var content = $.NSView.alloc.initWithFrame($.NSMakeRect(0, 0, width, height));
  content.setWantsLayer(true);
  content.layer.setBackgroundColor(
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.04, 0.045, 0.05, 0.88).CGColor
  );
  content.layer.setCornerRadius(38);
  content.layer.setMasksToBounds(false);

  var titleLabel = makeLabel($.NSMakeRect(72, 62, 448, 22), 13, 0.82, true);
  var lyricLabel = makeLabel($.NSMakeRect(72, 25, 448, 34), 20, 1.0, true);
  var translationLabel = makeLabel($.NSMakeRect(72, 16, 448, 20), 14, 0.74, true);
  translationLabel.setHidden(true);
  var fixButton = $.NSButton.buttonWithTitleTargetAction($("修正"), state.controller, "openCorrection:");
  fixButton.setFrame($.NSMakeRect(524, 38, 54, 28));
  fixButton.setBezelStyle($.NSBezelStyleRounded);
  fixButton.setFont($.NSFont.systemFontOfSize(12));

  var quitButton = $.NSButton.buttonWithTitleTargetAction($("×"), state.controller, "quitApp:");
  quitButton.setFrame($.NSMakeRect(584, 39, 26, 26));
  quitButton.setBordered(false);
  quitButton.setFont($.NSFont.systemFontOfSizeWeight(17, $.NSFontWeightMedium));
  quitButton.setContentTintColor($.NSColor.colorWithCalibratedWhiteAlpha(1, 0.72));
  quitButton.setToolTip($("退出灵动音乐"));

  var dot = $.NSView.alloc.initWithFrame($.NSMakeRect(26, 43, 18, 18));
  dot.setWantsLayer(true);
  dot.layer.setCornerRadius(9);
  dot.layer.setBackgroundColor(
    $.NSColor.colorWithCalibratedRedGreenBlueAlpha(0.12, 0.72, 0.5, 1).CGColor
  );

  content.addSubview(dot);
  content.addSubview(titleLabel);
  content.addSubview(lyricLabel);
  content.addSubview(translationLabel);
  content.addSubview(fixButton);
  content.addSubview(quitButton);
  window.setContentView(content);
  window.makeKeyAndOrderFront(null);

  state.window = window;
  state.titleLabel = titleLabel;
  state.lyricLabel = lyricLabel;
  state.translationLabel = translationLabel;
  state.statusButton = fixButton;
  applyDisplaySettings();
  updateLyricLayout(false);
}

function createStatusMenu() {
  var statusItem = $.NSStatusBar.systemStatusBar.statusItemWithLength($.NSSquareStatusItemLength);
  var button = statusItem.button;
  if (button) {
    var image = $.NSImage.imageWithSystemSymbolNameAccessibilityDescription(
      $("music.note"),
      $(PRODUCT_NAME)
    );
    if (image) {
      image.setTemplate(true);
      button.setImage(image);
    } else {
      button.setTitle($("♪"));
    }
    button.setToolTip($(PRODUCT_NAME));
  }

  var menu = $.NSMenu.alloc.initWithTitle($(PRODUCT_NAME));
  menu.setAutoenablesItems(false);

  var visibilityItem = addMenuItem(menu, "隐藏歌词", "toggleIsland:");
  addMenuItem(menu, "人工修正歌词…", "openCorrection:");
  menu.addItem($.NSMenuItem.separatorItem);
  addMenuItem(menu, "歌词提前 0.5 秒", "advanceLyrics:", "[", $.NSEventModifierFlagOption);
  addMenuItem(menu, "歌词恢复同步", "resetLyricsOffset:", "0", $.NSEventModifierFlagOption);
  addMenuItem(menu, "歌词延后 0.5 秒", "delayLyrics:", "]", $.NSEventModifierFlagOption);
  menu.addItem($.NSMenuItem.separatorItem);
  addMenuItem(menu, "打开自动化权限设置", "openAutomationSettings:");
  addMenuItem(menu, "关于灵动音乐", "showAbout:");
  menu.addItem($.NSMenuItem.separatorItem);
  addMenuItem(menu, "退出灵动音乐", "quitApp:");

  statusItem.setMenu(menu);
  state.statusItem = statusItem;
  state.visibilityMenuItem = visibilityItem;
}

function addMenuItem(menu, title, action, keyEquivalent, modifierMask) {
  var item = $.NSMenuItem.alloc.initWithTitleActionKeyEquivalent(
    $(title),
    action,
    $(keyEquivalent || "")
  );
  item.setTarget(state.controller);
  item.setEnabled(true);
  if (keyEquivalent && modifierMask !== undefined) {
    item.setKeyEquivalentModifierMask(modifierMask);
  }
  menu.addItem(item);
  return item;
}

function toggleIslandVisibility() {
  if (!state.window) {
    return;
  }
  if (state.window.isVisible) {
    state.window.orderOut(null);
  } else {
    state.window.orderFrontRegardless;
  }
  updateVisibilityMenuItem();
}

function updateVisibilityMenuItem() {
  if (!state.visibilityMenuItem || !state.window) {
    return;
  }
  state.visibilityMenuItem.setTitle($(state.window.isVisible ? "隐藏歌词" : "显示歌词"));
}

function openAutomationSettings() {
  var url = $.NSURL.URLWithString(
    $("x-apple.systempreferences:com.apple.preference.security?Privacy_Automation")
  );
  $.NSWorkspace.sharedWorkspace.openURL(url);
}

function showAboutDialog() {
  var alert = $.NSAlert.alloc.init;
  alert.setMessageText($(PRODUCT_NAME));
  alert.setInformativeText($(
    "版本 " + PRODUCT_VERSION + "\n\n" +
    "为 Apple Music 提供轻量悬浮同步歌词。\n" +
    "用户数据保存在：\n" + DATA_ROOT
  ));
  alert.addButtonWithTitle($("好"));
  alert.runModal;
}

function getVisibleScreenFrame() {
  var fallback = {
    origin: { x: 0, y: 0 },
    size: { width: 1440, height: 900 }
  };

  try {
    var screen = $.NSScreen.mainScreen;
    if (!screen) {
      return fallback;
    }
    var frame = screen.visibleFrame;
    if (!frame || !frame.origin || !frame.size) {
      return fallback;
    }
    return frame;
  } catch (_error) {
    return fallback;
  }
}

function makeLabel(frame, size, alpha, center) {
  var label = $.NSTextField.alloc.initWithFrame(frame);
  label.setEditable(false);
  label.setSelectable(false);
  label.setBordered(false);
  label.setDrawsBackground(false);
  label.setTextColor($.NSColor.colorWithCalibratedWhiteAlpha(1, alpha));
  label.setFont($.NSFont.systemFontOfSizeWeight(size, $.NSFontWeightMedium));
  label.setLineBreakMode($.NSLineBreakByTruncatingTail);
  label.setMaximumNumberOfLines(1);
  if (center) {
    label.setAlignment($.NSTextAlignmentCenter);
  }
  return label;
}

function applyDisplaySettings() {
  if (!state.settings) {
    state.settings = defaultSettings();
  }
  state.settings = normalizeSettings(state.settings);
  if (state.lyricLabel) {
    state.lyricLabel.setFont(
      $.NSFont.systemFontOfSizeWeight(state.settings.lyricFontSize, $.NSFontWeightSemibold)
    );
    state.lyricLabel.setTextColor(nsColorFromHex(state.settings.lyricColorHex));
  }
  if (state.translationLabel) {
    state.translationLabel.setFont(
      $.NSFont.systemFontOfSizeWeight(
        Math.max(12, state.settings.lyricFontSize - 6),
        $.NSFontWeightMedium
      )
    );
    state.translationLabel.setTextColor($.NSColor.colorWithCalibratedWhiteAlpha(1, 0.74));
  }
}

function updateLyricLayout(hasTranslation) {
  if (!state.titleLabel || !state.lyricLabel || !state.translationLabel) {
    return;
  }
  if (hasTranslation) {
    state.titleLabel.setFrame($.NSMakeRect(72, 70, 448, 20));
    state.lyricLabel.setFrame($.NSMakeRect(72, 39, 448, 28));
    state.translationLabel.setFrame($.NSMakeRect(72, 17, 448, 20));
  } else {
    state.titleLabel.setFrame($.NSMakeRect(72, 62, 448, 22));
    state.lyricLabel.setFrame($.NSMakeRect(72, 25, 448, 34));
    state.translationLabel.setFrame($.NSMakeRect(72, 14, 448, 20));
  }
}

function renderStatus(title, lyric, translation) {
  if (!state.titleLabel || !state.lyricLabel) {
    return;
  }
  var translatedLine = String(translation || "").trim();
  state.titleLabel.setStringValue($(title || PRODUCT_NAME));
  state.lyricLabel.setStringValue($(lyric || ""));
  if (state.translationLabel) {
    state.translationLabel.setStringValue($(translatedLine));
    state.translationLabel.setHidden(!translatedLine);
    updateLyricLayout(!!translatedLine);
  }
}

function pollAndRender() {
  var musicState = readMusicState();

  if (musicState.kind === "waiting") {
    resetCurrentTrack();
    renderStatus("等待 Music.app", "打开 Music.app 播放歌曲");
    return;
  }

  if (musicState.kind === "permission") {
    resetCurrentTrack();
    renderStatus("需要允许控制 Music.app", "系统设置 > 隐私与安全性 > 自动化");
    return;
  }

  if (musicState.kind === "stopped") {
    resetCurrentTrack();
    renderStatus("暂无播放内容", "在 Music.app 中开始播放后会自动显示歌词");
    return;
  }

  if (musicState.kind === "error") {
    renderStatus(PRODUCT_NAME, "读取 Music.app 状态失败");
    return;
  }

  var meta = musicState.meta;
  var key = makeTrackFingerprint(meta);
  var title = formatTrackTitle(meta, musicState.playbackState);

  if (key !== state.currentKey) {
    state.currentKey = key;
    state.currentMeta = meta;
    state.currentLyrics = [];
    state.currentLyricsSource = "";
    state.currentLrclibId = "";
    state.currentOffsetSeconds = 0;
    state.lastDisplayLine = "";
    renderStatus(title, "正在匹配歌词");
    resolveLyricsForCurrentTrack(meta, key);
  }

  if (!state.currentLyrics || state.currentLyrics.length === 0) {
    if (state.lastError) {
      renderStatus(title, state.lastError);
    } else {
      renderStatus(title, "未找到同步歌词");
    }
    return;
  }

  var entry = findLyricEntry(state.currentLyrics, musicState.position, state.currentOffsetSeconds);
  renderLyricEntry(title, entry, musicState.playbackState === "paused");
}

function resetCurrentTrack() {
  state.currentMeta = null;
  state.currentKey = "";
  state.currentLyrics = [];
  state.currentLyricsSource = "";
  state.currentLrclibId = "";
  state.currentOffsetSeconds = 0;
  state.lastDisplayLine = "";
  state.lastLookupKey = "";
  state.lastError = "";
}

function readMusicState() {
  try {
    var music = getMusicApplication();
    if (!music) {
      return { kind: "waiting" };
    }
    if (!music.running()) {
      return { kind: "waiting" };
    }

    var playbackState = String(music.playerState());
    if (playbackState === "stopped") {
      return { kind: "stopped" };
    }

    var track = music.currentTrack;
    if (!track) {
      return { kind: "stopped" };
    }

    var meta = {
      title: safeMusicValue(function() { return track.name(); }),
      artist: safeMusicValue(function() { return track.artist(); }),
      album: safeMusicValue(function() { return track.album(); }),
      duration: toNumber(safeMusicValue(function() { return track.duration(); })),
      position: toNumber(safeMusicValue(function() { return music.playerPosition(); })),
      persistentId: safeMusicValue(function() { return track.persistentID(); }),
      databaseId: safeMusicValue(function() { return track.databaseID(); })
    };

    if (!meta.title && !meta.artist) {
      return { kind: "stopped" };
    }

    return {
      kind: "ready",
      playbackState: playbackState,
      position: meta.position || 0,
      meta: meta
    };
  } catch (error) {
    if (looksLikeMusicUnavailableError(error)) {
      return { kind: "waiting" };
    }
    if (looksLikeAutomationPermissionError(error)) {
      return { kind: "permission" };
    }
    return { kind: "error", error: String(error) };
  }
}

function getMusicApplication() {
  var names = ["Music", "音乐", "iTunes"];
  for (var i = 0; i < names.length; i++) {
    try {
      return Application(names[i]);
    } catch (_error) {
    }
  }
  return null;
}

function safeMusicValue(getter) {
  try {
    var value = getter();
    if (value === null || value === undefined) {
      return "";
    }
    var text = String(value).trim();
    if (!text ||
      text === "missing value" ||
      text === "undefined" ||
      text === "null") {
      return "";
    }
    return text;
  } catch (_error) {
    return "";
  }
}

function looksLikeMusicUnavailableError(error) {
  var message = String(error).toLowerCase();
  return message.indexOf("application can't be found") >= 0 ||
    message.indexOf("应用程序") >= 0 && message.indexOf("找不到") >= 0;
}

function looksLikeAutomationPermissionError(error) {
  var message = String(error).toLowerCase();
  return message.indexOf("-1743") >= 0 ||
    message.indexOf("not authorized") >= 0 ||
    message.indexOf("not permitted") >= 0 ||
    message.indexOf("automation") >= 0 ||
    message.indexOf("权限") >= 0 ||
    message.indexOf("不允许") >= 0;
}

function resolveLyricsForCurrentTrack(meta, key) {
  state.lastError = "";
  state.lastLookupKey = key;

  var override = findOverride(meta);
  if (override) {
    var loaded = loadLyricsFromOverride(override);
    if (loaded.ok) {
      state.currentLyrics = loaded.lines;
      state.currentLyricsSource = override.source || "override";
      state.currentLrclibId = loaded.lrclibId || override.lrclibId || "";
      state.currentOffsetSeconds = toNumber(override.offsetSeconds);
      return;
    }
    state.lastError = loaded.message;
  }

  try {
    var exact = fetchLrclibExact(meta);
    if (exact && exact.syncedLyrics) {
      var exactLines = parseLrc(exact.syncedLyrics || "");
      if (exactLines.length > 0) {
        state.currentLyrics = exactLines;
        state.currentLyricsSource = "lrclib:" + exact.id;
        state.currentLrclibId = String(exact.id);
        state.currentOffsetSeconds = 0;
        return;
      }
    }

    var candidates = searchLrclibCandidates(meta);
    var best = chooseBestCandidate(meta, candidates);
    if (!best) {
      state.currentLyrics = [];
      state.currentLyricsSource = "";
      state.lastError = "未找到同步歌词";
      return;
    }

    var lines = parseLrc(best.syncedLyrics || "");
    if (lines.length === 0) {
      state.lastError = "未找到同步歌词";
      return;
    }

    state.currentLyrics = lines;
    state.currentLyricsSource = "lrclib:" + best.id;
    state.currentLrclibId = String(best.id);
    state.currentOffsetSeconds = 0;
  } catch (error) {
    state.currentLyrics = [];
    state.currentLyricsSource = "";
    state.currentLrclibId = "";
    state.currentOffsetSeconds = 0;
    state.lastError = "歌词服务暂不可用";
  }
}

function findOverride(meta) {
  if (!state.overrides) {
    state.overrides = loadOverrides();
  }
  var keys = makeTrackKeys(meta);
  for (var i = 0; i < keys.length; i++) {
    if (state.overrides.tracks[keys[i]]) {
      return state.overrides.tracks[keys[i]];
    }
  }
  return null;
}

function loadLyricsFromOverride(override) {
  try {
    if (override.source === "manual-lrc" && override.lrcText) {
      var manualLines = parseLrc(override.lrcText);
      if (manualLines.length > 0) {
        return { ok: true, lines: manualLines, lrclibId: "" };
      }
      return { ok: false, message: "本地 LRC 无可用时间戳" };
    }

    if (override.source === "lrclib" && override.lrclibId) {
      var item = fetchLrclibById(override.lrclibId);
      var lines = parseLrc(item.syncedLyrics || "");
      if (lines.length > 0) {
        return { ok: true, lines: lines, lrclibId: String(override.lrclibId) };
      }
      return { ok: false, message: "未找到同步歌词" };
    }
  } catch (_error) {
    return { ok: false, message: "歌词服务暂不可用" };
  }

  return { ok: false, message: "本地映射不可用" };
}

function fetchLrclibExact(meta) {
  var variants = buildExactSearchVariants(meta);
  for (var i = 0; i < variants.length; i++) {
    try {
      return fetchJson(LRCLIB_BASE_URL + "/get?" + buildQuery(variants[i]), 8);
    } catch (_error) {
      // Try the next cleaned-up variant before falling back to broad search.
    }
  }
  return null;
}

function buildExactSearchVariants(meta) {
  var variants = [];
  var titleCandidates = titleSearchCandidates(meta.title || "");
  var artist = meta.artist || "";
  var album = meta.album || "";
  var duration = Math.round(toNumber(meta.duration));

  for (var i = 0; i < titleCandidates.length; i++) {
    addVariant(variants, titleCandidates[i], artist, album, duration);
    if (album) {
      addVariant(variants, titleCandidates[i], artist, "", duration);
    }
  }

  return variants;
}

function searchLrclibCandidates(meta) {
  var variants = buildSearchVariants(meta);
  var seen = {};
  var results = [];

  for (var i = 0; i < variants.length; i++) {
    var url = LRCLIB_BASE_URL + "/search?" + buildQuery(variants[i]);
    var items = fetchJson(url, 18);
    if (!items || !items.length) {
      continue;
    }
    for (var j = 0; j < items.length; j++) {
      var item = items[j];
      if (!item || !item.id || seen[item.id]) {
        continue;
      }
      seen[item.id] = true;
      results.push(item);
    }
  }

  return results;
}

function buildSearchVariants(meta) {
  var variants = [];
  var title = meta.title || "";
  var artist = meta.artist || "";
  var album = meta.album || "";
  var duration = Math.round(toNumber(meta.duration));
  var titleCandidates = titleSearchCandidates(title);
  var artists = splitArtists(artist);

  for (var i = 0; i < titleCandidates.length; i++) {
    addBroadSearchVariants(variants, titleCandidates[i], artist, album, duration);
  }

  if (artists.length > 0 && artists[0] !== artist) {
    for (var j = 0; j < titleCandidates.length; j++) {
      addBroadSearchVariants(variants, titleCandidates[j], artists[0], album, duration);
    }
  }

  return variants;
}

function addBroadSearchVariants(variants, title, artist, album, duration) {
  addVariant(variants, title, artist, album, duration);
  if (album) {
    addVariant(variants, title, artist, "", duration);
  }
  if (duration) {
    addVariant(variants, title, artist, album, 0);
    if (album) {
      addVariant(variants, title, artist, "", 0);
    }
  }
  if (artist) {
    addVariant(variants, title, artist, "", 0);
  }
  addVariant(variants, title, "", "", 0);
}

function addVariant(variants, title, artist, album, duration) {
  var params = {};
  if (title) {
    params.track_name = title;
  }
  if (artist) {
    params.artist_name = artist;
  }
  if (album) {
    params.album_name = album;
  }
  if (duration) {
    params.duration = String(duration);
  }

  var signature = JSON.stringify(params);
  for (var i = 0; i < variants.length; i++) {
    if (JSON.stringify(variants[i]) === signature) {
      return;
    }
  }
  variants.push(params);
}

function chooseBestCandidate(meta, candidates) {
  var best = null;
  var bestScore = -9999;

  for (var i = 0; i < candidates.length; i++) {
    var candidate = candidates[i];
    var score = scoreCandidate(meta, candidate);
    if (score > bestScore) {
      bestScore = score;
      best = candidate;
    }
  }

  if (!best || !best.syncedLyrics || bestScore < 35) {
    return null;
  }

  return best;
}

function scoreCandidate(meta, candidate) {
  var score = 0;

  if (candidate.syncedLyrics) {
    score += 60;
  } else {
    score -= 1000;
  }

  score += similarityScore(meta.title, candidate.trackName) * 38;
  score += similarityScore(meta.artist, candidate.artistName) * 24;
  score += similarityScore(meta.album, candidate.albumName) * 10;

  var duration = Math.round(toNumber(meta.duration));
  var candidateDuration = Math.round(toNumber(candidate.duration));
  if (duration && candidateDuration) {
    var diff = Math.abs(duration - candidateDuration);
    if (diff <= 2) {
      score += 22;
    } else if (diff <= 5) {
      score += 14;
    } else if (diff <= 10) {
      score += 6;
    } else {
      score -= Math.min(28, diff / 2);
    }
  }

  return score;
}

function similarityScore(left, right) {
  var a = normalizeForCompare(cleanTitleForMatch(left || ""));
  var b = normalizeForCompare(cleanTitleForMatch(right || ""));
  if (!a || !b) {
    return 0;
  }
  if (a === b) {
    return 1;
  }
  if (a.indexOf(b) >= 0 || b.indexOf(a) >= 0) {
    return 0.72;
  }

  var aTokens = a.split(" ");
  var bTokens = b.split(" ");
  var hits = 0;
  for (var i = 0; i < aTokens.length; i++) {
    if (aTokens[i] && bTokens.indexOf(aTokens[i]) >= 0) {
      hits += 1;
    }
  }
  return hits / Math.max(aTokens.length, bTokens.length);
}

function fetchLrclibById(id) {
  return fetchJson(LRCLIB_BASE_URL + "/get/" + encodeURIComponent(String(id)), 10);
}

function fetchJson(url, timeoutSeconds) {
  var timeout = timeoutSeconds || 12;
  var command = "/usr/bin/curl --fail --silent --show-error --location --compressed --max-time " +
    String(timeout) + " --user-agent " +
    shellQuote(USER_AGENT) + " " + shellQuote(url);
  var output = app.doShellScript(command);
  return JSON.parse(output);
}

function buildQuery(params) {
  var pairs = [];
  var keys = Object.keys(params);
  for (var i = 0; i < keys.length; i++) {
    var key = keys[i];
    if (params[key] !== "" && params[key] !== null && params[key] !== undefined) {
      pairs.push(encodeURIComponent(key) + "=" + encodeURIComponent(String(params[key])));
    }
  }
  return pairs.join("&");
}

function shellQuote(value) {
  return "'" + String(value).replace(/'/g, "'\\''") + "'";
}

function parseLrc(text) {
  var rawLines = [];
  var sourceLines = String(text || "").replace(/\r/g, "").split("\n");

  for (var i = 0; i < sourceLines.length; i++) {
    var raw = sourceLines[i];
    var matches = [];
    var regex = /\[(\d{1,2}):(\d{2})(?:[.:](\d{1,3}))?\]/g;
    var match = null;

    while ((match = regex.exec(raw)) !== null) {
      var minutes = parseInt(match[1], 10);
      var seconds = parseInt(match[2], 10);
      var fraction = match[3] || "0";
      var millis = parseFractionMillis(fraction);
      matches.push(minutes * 60 + seconds + millis / 1000);
    }

    if (matches.length === 0) {
      continue;
    }

    var lyric = raw.replace(regex, "").trim();
    for (var j = 0; j < matches.length; j++) {
      rawLines.push({
        time: matches[j],
        text: lyric || "♪"
      });
    }
  }

  rawLines.sort(function(a, b) {
    return a.time - b.time;
  });

  return mergeBilingualLyricLines(rawLines);
}

function mergeBilingualLyricLines(lines) {
  if (!lines || lines.length === 0) {
    return [];
  }

  var merged = [];
  var group = [];
  var groupKey = null;
  for (var i = 0; i < lines.length; i++) {
    var line = lines[i];
    var key = lyricTimeKey(line.time);
    if (group.length > 0 && key !== groupKey) {
      merged.push(mergeLyricGroup(group));
      group = [];
    }
    group.push(line);
    groupKey = key;
  }
  if (group.length > 0) {
    merged.push(mergeLyricGroup(group));
  }
  return merged;
}

function lyricTimeKey(time) {
  return String(Math.round(toNumber(time) * 100));
}

function mergeLyricGroup(group) {
  var chineseLines = [];
  var nonChineseLines = [];
  for (var i = 0; i < group.length; i++) {
    var text = String(group[i].text || "").trim() || "♪";
    if (isLikelyChineseLine(text)) {
      chineseLines.push(text);
    } else {
      nonChineseLines.push(text);
    }
  }

  var text = group[0].text || "♪";
  var translation = "";
  if (nonChineseLines.length > 0 && chineseLines.length > 0) {
    text = nonChineseLines[0];
    translation = firstDistinctLine(chineseLines, text);
  }

  return {
    time: group[0].time,
    text: text || "♪",
    translation: translation
  };
}

function firstDistinctLine(lines, original) {
  var originalCompare = normalizeForCompare(original);
  for (var i = 0; i < lines.length; i++) {
    var line = String(lines[i] || "").trim();
    if (line && normalizeForCompare(line) !== originalCompare) {
      return line;
    }
  }
  return "";
}

function parseFractionMillis(value) {
  var text = String(value || "0");
  if (text.length === 1) {
    return parseInt(text, 10) * 100;
  }
  if (text.length === 2) {
    return parseInt(text, 10) * 10;
  }
  return parseInt(text.substring(0, 3), 10);
}

function findLyricLine(lines, position, offsetSeconds) {
  return findLyricEntry(lines, position, offsetSeconds).text;
}

function findLyricEntry(lines, position, offsetSeconds) {
  if (!lines || lines.length === 0) {
    return { time: 0, text: "未找到同步歌词", translation: "" };
  }

  var current = normalizeLyricEntry(lines[0]);
  var time = Math.max(0, toNumber(position) + toNumber(offsetSeconds) + 0.15);
  for (var i = 0; i < lines.length; i++) {
    if (lines[i].time <= time) {
      current = normalizeLyricEntry(lines[i]);
    } else {
      break;
    }
  }
  return current;
}

function normalizeLyricEntry(entry) {
  if (!entry) {
    return { time: 0, text: "♪", translation: "" };
  }
  return {
    time: toNumber(entry.time),
    text: String(entry.text || "♪"),
    translation: String(entry.translation || "")
  };
}

function renderLyricEntry(title, entry, paused) {
  var normalized = normalizeLyricEntry(entry);
  var translation = shouldShowChineseTranslation(normalized.text, normalized.translation) ?
    normalized.translation :
    "";
  renderStatus(title, (paused ? "暂停 · " : "") + normalized.text, translation);
}

function shouldShowChineseTranslation(original, translation) {
  var translatedLine = String(translation || "").trim();
  if (!translatedLine) {
    return false;
  }
  if (!isLikelyChineseLine(translatedLine)) {
    return false;
  }
  if (isLikelyChineseLine(original)) {
    return false;
  }
  return normalizeForCompare(original) !== normalizeForCompare(translatedLine);
}

function isLikelyChineseLine(value) {
  var text = String(value || "");
  return containsChineseCharacters(text) &&
    !containsJapaneseKana(text) &&
    !containsHangul(text);
}

function containsChineseCharacters(value) {
  return /[\u3400-\u9fff\uf900-\ufaff]/.test(String(value || ""));
}

function containsJapaneseKana(value) {
  return /[\u3040-\u30ff]/.test(String(value || ""));
}

function containsHangul(value) {
  return /[\uac00-\ud7af]/.test(String(value || ""));
}

function openCorrectionPanel() {
  if (state.correctionPanel) {
    populateCorrectionFields();
    state.correctionPanel.makeKeyAndOrderFront(null);
    $.NSApplication.sharedApplication.activateIgnoringOtherApps(true);
    return;
  }

  var width = 520;
  var height = 620;
  var panel = $.NSPanel.alloc.initWithContentRectStyleMaskBackingDefer(
    $.NSMakeRect(0, 0, width, height),
    $.NSWindowStyleMaskTitled | $.NSWindowStyleMaskClosable,
    $.NSBackingStoreBuffered,
    false
  );
  panel.setTitle($("人工补充歌词"));
  panel.setFloatingPanel(true);
  panel.setLevel($.NSFloatingWindowLevel);

  var content = $.NSView.alloc.initWithFrame($.NSMakeRect(0, 0, width, height));
  var y = height - 52;

  state.fields.title = addTextField(content, "歌名", 22, y, 332, state.currentMeta ? state.currentMeta.title : "");
  state.fields.artist = addTextField(content, "歌手", 22, y - 44, 332, state.currentMeta ? state.currentMeta.artist : "");
  state.fields.album = addTextField(content, "专辑", 22, y - 88, 332, state.currentMeta ? state.currentMeta.album : "");
  state.fields.duration = addTextField(content, "时长", 386, y, 90, state.currentMeta ? String(Math.round(toNumber(state.currentMeta.duration))) : "");
  state.fields.lrclibId = addTextField(content, "LRCLIB ID", 386, y - 44, 90, "");
  addStaticLabel(content, "歌词快慢", 322, y - 82, 56, 18);
  addOffsetButton(content, "早", 386, y - 88, "advanceLyrics:", "[", "歌词提前 0.5 秒（⌥[）");
  addOffsetButton(content, "准", 418, y - 88, "resetLyricsOffset:", "0", "恢复同步（⌥0）");
  addOffsetButton(content, "晚", 450, y - 88, "delayLyrics:", "]", "歌词延后 0.5 秒（⌥]）");
  state.fields.offsetStatus = makeOffsetStatusLabel(content, 386, y - 112, 90, 18);
  state.fields.lyricFontSize = addTextField(content, "歌词字号", 386, y - 132, 90, "");
  state.fields.lyricColorHex = addTextField(content, "歌词颜色", 386, y - 176, 90, "");

  var searchButton = $.NSButton.buttonWithTitleTargetAction($("重新搜索"), state.controller, "searchCandidates:");
  searchButton.setFrame($.NSMakeRect(386, y - 220, 90, 30));
  searchButton.setBezelStyle($.NSBezelStyleRounded);
  content.addSubview(searchButton);

  addStaticLabel(content, "候选", 22, y - 262, 56, 18);
  var popup = $.NSPopUpButton.alloc.initWithFramePullsDown($.NSMakeRect(86, y - 268, 390, 28), false);
  popup.addItemWithTitle($("暂无候选"));
  content.addSubview(popup);
  state.candidatePopup = popup;

  addStaticLabel(content, "LRC", 22, y - 312, 56, 18);
  var scroll = $.NSScrollView.alloc.initWithFrame($.NSMakeRect(86, 86, 390, 222));
  scroll.setHasVerticalScroller(true);
  scroll.setBorderType($.NSBezelBorder);
  var lrcView = $.NSTextView.alloc.initWithFrame($.NSMakeRect(0, 0, 390, 222));
  lrcView.setFont($.NSFont.userFixedPitchFontOfSize(12));
  scroll.setDocumentView(lrcView);
  content.addSubview(scroll);
  state.fields.lrcText = lrcView;

  var styleButton = $.NSButton.buttonWithTitleTargetAction($("应用样式"), state.controller, "saveDisplaySettings:");
  styleButton.setFrame($.NSMakeRect(202, 28, 90, 32));
  styleButton.setBezelStyle($.NSBezelStyleRounded);
  content.addSubview(styleButton);

  var saveButton = $.NSButton.buttonWithTitleTargetAction($("保存"), state.controller, "saveCorrection:");
  saveButton.setFrame($.NSMakeRect(302, 28, 82, 32));
  saveButton.setBezelStyle($.NSBezelStyleRounded);
  content.addSubview(saveButton);

  var cancelButton = $.NSButton.buttonWithTitleTargetAction($("取消"), state.controller, "cancelCorrection:");
  cancelButton.setFrame($.NSMakeRect(394, 28, 82, 32));
  cancelButton.setBezelStyle($.NSBezelStyleRounded);
  content.addSubview(cancelButton);

  panel.setContentView(content);
  panel.center;
  state.correctionPanel = panel;
  populateCorrectionFields();
  panel.makeKeyAndOrderFront(null);
  $.NSApplication.sharedApplication.activateIgnoringOtherApps(true);
}

function addStaticLabel(content, text, x, y, width, height) {
  var label = $.NSTextField.alloc.initWithFrame($.NSMakeRect(x, y, width, height));
  label.setStringValue($(text));
  label.setEditable(false);
  label.setSelectable(false);
  label.setBordered(false);
  label.setDrawsBackground(false);
  label.setTextColor($.NSColor.secondaryLabelColor);
  label.setAlignment($.NSTextAlignmentRight);
  content.addSubview(label);
  return label;
}

function addTextField(content, labelText, x, y, inputWidth, value) {
  addStaticLabel(content, labelText, x, y + 6, 56, 18);
  var field = $.NSTextField.alloc.initWithFrame($.NSMakeRect(x + 64, y, inputWidth, 28));
  field.setStringValue($(value || ""));
  content.addSubview(field);
  return field;
}

function addOffsetButton(content, title, x, y, action, keyEquivalent, tooltip) {
  var button = $.NSButton.buttonWithTitleTargetAction($(title), state.controller, action);
  button.setFrame($.NSMakeRect(x, y, 28, 28));
  button.setBezelStyle($.NSBezelStyleRounded);
  button.setFont($.NSFont.systemFontOfSize(12));
  button.setKeyEquivalent($(keyEquivalent));
  button.setKeyEquivalentModifierMask($.NSEventModifierFlagOption);
  button.setToolTip($(tooltip));
  content.addSubview(button);
  return button;
}

function makeOffsetStatusLabel(content, x, y, width, height) {
  var label = $.NSTextField.alloc.initWithFrame($.NSMakeRect(x, y, width, height));
  label.setEditable(false);
  label.setSelectable(false);
  label.setBordered(false);
  label.setDrawsBackground(false);
  label.setTextColor($.NSColor.secondaryLabelColor);
  label.setFont($.NSFont.systemFontOfSize(11));
  label.setAlignment($.NSTextAlignmentCenter);
  content.addSubview(label);
  return label;
}

function populateCorrectionFields() {
  if (!state.currentMeta || !state.fields.title) {
    return;
  }
  state.fields.title.setStringValue($(state.currentMeta.title || ""));
  state.fields.artist.setStringValue($(state.currentMeta.artist || ""));
  state.fields.album.setStringValue($(state.currentMeta.album || ""));
  state.fields.duration.setStringValue($(String(Math.round(toNumber(state.currentMeta.duration)))));
  if (state.fields.lrclibId) {
    state.fields.lrclibId.setStringValue($(state.currentLrclibId || sourceLrclibId(state.currentLyricsSource) || ""));
  }
  updateOffsetStatusLabel();
  if (state.fields.lyricFontSize || state.fields.lyricColorHex) {
    populateDisplaySettingsFields();
  }
}

function populateDisplaySettingsFields() {
  if (!state.settings) {
    state.settings = loadSettings();
  }
  state.settings = normalizeSettings(state.settings);
  if (state.fields.lyricFontSize) {
    state.fields.lyricFontSize.setStringValue($(String(state.settings.lyricFontSize)));
  }
  if (state.fields.lyricColorHex) {
    state.fields.lyricColorHex.setStringValue($(state.settings.lyricColorHex));
  }
}

function closeCorrectionPanel() {
  if (state.correctionPanel) {
    state.correctionPanel.orderOut(null);
  }
}

function readManualMeta() {
  return {
    title: fieldString("title"),
    artist: fieldString("artist"),
    album: fieldString("album"),
    duration: toNumber(fieldString("duration")),
    persistentId: state.currentMeta ? state.currentMeta.persistentId : "",
    databaseId: state.currentMeta ? state.currentMeta.databaseId : ""
  };
}

function readDisplaySettingsFields() {
  var current = normalizeSettings(state.settings || defaultSettings());
  return normalizeSettings({
    lyricFontSize: fieldString("lyricFontSize") || current.lyricFontSize,
    lyricColorHex: fieldString("lyricColorHex") || current.lyricColorHex
  });
}

function saveDisplaySettingsFromFields() {
  state.settings = readDisplaySettingsFields();
  saveSettings();
  applyDisplaySettings();
}

function saveDisplaySettingsOnly() {
  saveDisplaySettingsFromFields();
  renderStatus(
    state.currentMeta ? formatTrackTitle(state.currentMeta, "paused") : PRODUCT_NAME,
    "显示样式已保存"
  );
}

function fieldString(name) {
  var field = state.fields[name];
  if (!field) {
    return "";
  }
  return String(ObjC.unwrap(field.stringValue)).trim();
}

function textViewString(view) {
  if (!view) {
    return "";
  }
  return String(ObjC.unwrap(view.string)).trim();
}

function searchManualCandidates() {
  var popup = state.candidatePopup;
  if (!popup) {
    return;
  }

  popup.removeAllItems;
  popup.addItemWithTitle($("正在搜索..."));
  state.manualCandidates = [];

  try {
    var meta = readManualMeta();
    var candidates = searchLrclibCandidates(meta);
    candidates.sort(function(a, b) {
      return scoreCandidate(meta, b) - scoreCandidate(meta, a);
    });
    state.manualCandidates = candidates;

    popup.removeAllItems;
    if (candidates.length === 0) {
      popup.addItemWithTitle($("没有候选"));
      return;
    }

    for (var i = 0; i < Math.min(candidates.length, 20); i++) {
      var item = candidates[i];
      var label = "#" + item.id + " · " +
        compact(item.trackName, 24) + " - " +
        compact(item.artistName, 18) +
        (item.syncedLyrics ? " · 同步" : " · 无同步") +
        (item.duration ? " · " + Math.round(item.duration) + "s" : "");
      popup.addItemWithTitle($(label));
    }
  } catch (_error) {
    popup.removeAllItems;
    popup.addItemWithTitle($("歌词服务暂不可用"));
  }
}

function saveCorrection() {
  saveDisplaySettingsFromFields();
  var meta = readManualMeta();
  var offsetSeconds = clampOffsetSeconds(state.currentOffsetSeconds);
  var lrcText = textViewString(state.fields.lrcText);
  var lrclibId = fieldString("lrclibId");
  var selectedCandidate = getSelectedManualCandidate();
  var entry = null;
  var parsedLines = [];

  if (lrcText) {
    parsedLines = parseLrc(lrcText);
    if (parsedLines.length === 0) {
      renderStatus(formatTrackTitle(meta, "paused"), "粘贴的 LRC 没有可用时间戳");
      return;
    }
    entry = {
      title: meta.title,
      artist: meta.artist,
      album: meta.album,
      duration: Math.round(toNumber(meta.duration)),
      source: "manual-lrc",
      offsetSeconds: offsetSeconds,
      lrcText: lrcText,
      updatedAt: new Date().toISOString()
    };
  } else {
    var id = lrclibId || (selectedCandidate ? String(selectedCandidate.id) : "");
    if (!id) {
      renderStatus(formatTrackTitle(meta, "paused"), "请填写 LRCLIB ID、选择候选或粘贴 LRC");
      return;
    }

    try {
      var item = fetchLrclibById(id);
      parsedLines = parseLrc(item.syncedLyrics || "");
      if (parsedLines.length === 0) {
        renderStatus(formatTrackTitle(meta, "paused"), "该 LRCLIB 条目没有同步歌词");
        return;
      }
      entry = {
        title: meta.title || item.trackName || "",
        artist: meta.artist || item.artistName || "",
        album: meta.album || item.albumName || "",
        duration: Math.round(toNumber(meta.duration || item.duration)),
        source: "lrclib",
        lrclibId: parseInt(id, 10),
        offsetSeconds: offsetSeconds,
        updatedAt: new Date().toISOString()
      };
    } catch (_error) {
      renderStatus(formatTrackTitle(meta, "paused"), "歌词服务暂不可用");
      return;
    }
  }

  var keys = makeTrackKeys(meta);
  var key = keys[0];
  if (!state.overrides) {
    state.overrides = loadOverrides();
  }
  state.overrides.tracks[key] = entry;
  saveOverrides();

  state.currentMeta = meta;
  state.currentKey = makeTrackFingerprint(meta);
  state.currentLyrics = parsedLines;
  state.currentLyricsSource = entry.source;
  state.currentLrclibId = entry.lrclibId ? String(entry.lrclibId) : "";
  state.currentOffsetSeconds = offsetSeconds;
  state.lastError = "";
  renderLyricEntry(
    formatTrackTitle(meta, "paused"),
    findLyricEntry(parsedLines, state.currentMeta ? state.currentMeta.position : 0, state.currentOffsetSeconds),
    false
  );
  closeCorrectionPanel();
}

function getSelectedManualCandidate() {
  if (!state.candidatePopup || !state.manualCandidates || state.manualCandidates.length === 0) {
    return null;
  }
  var index = state.candidatePopup.indexOfSelectedItem;
  if (index < 0 || index >= state.manualCandidates.length) {
    return null;
  }
  return state.manualCandidates[index];
}

function makeTrackKey(meta) {
  return makeTrackKeys(meta)[0];
}

function makeTrackFingerprint(meta) {
  var artist = normalizeForKey(meta ? meta.artist : "");
  var title = normalizeForKey(meta ? meta.title : "");
  var album = normalizeForKey(meta ? meta.album : "");
  var duration = Math.round(toNumber(meta ? meta.duration : 0));
  var id = validMusicId(meta && meta.persistentId) || validMusicId(meta && meta.databaseId) || "no-id";
  return "playback:" + id + "|" + artist + "|" + title + "|" + album + "|" + duration;
}

function makeTrackKeys(meta) {
  var keys = [];
  var persistentId = validMusicId(meta && meta.persistentId);
  var databaseId = validMusicId(meta && meta.databaseId);

  if (persistentId) {
    keys.push("music-track-id:" + persistentId);
  } else if (databaseId) {
    keys.push("music-track-id:" + databaseId);
  }

  var artist = normalizeForKey(meta ? meta.artist : "");
  var title = normalizeForKey(meta ? meta.title : "");
  var duration = Math.round(toNumber(meta ? meta.duration : 0));
  if (artist || title || duration) {
    keys.push("normalized:" + artist + "|" + title + "|" + duration);
  }

  if (keys.length === 0) {
    keys.push("normalized:unknown|unknown|0");
  }
  return keys;
}

function validMusicId(value) {
  var text = String(value || "").trim();
  if (!text ||
    text === "missing value" ||
    text === "undefined" ||
    text === "null" ||
    text === "0") {
    return "";
  }
  return text;
}

function sourceLrclibId(source) {
  var text = String(source || "");
  if (text.indexOf("lrclib:") !== 0) {
    return "";
  }
  return text.substring("lrclib:".length);
}

function clampOffsetSeconds(value) {
  var number = toNumber(value);
  if (number > 120) {
    return 120;
  }
  if (number < -120) {
    return -120;
  }
  return Math.round(number * 10) / 10;
}

function adjustCurrentOffset(deltaSeconds) {
  setCurrentOffset(state.currentOffsetSeconds + deltaSeconds);
}

function setCurrentOffset(value) {
  state.currentOffsetSeconds = clampOffsetSeconds(value);
  updateOffsetStatusLabel();

  var saved = persistCurrentOffset();
  if (!state.currentMeta) {
    renderStatus(PRODUCT_NAME, "暂无播放内容，无法调整歌词快慢");
    return;
  }

  var message = formatOffsetDescription(state.currentOffsetSeconds);
  renderStatus(
    formatTrackTitle(state.currentMeta, "paused"),
    saved ? message + " · 已自动保存" : message
  );
}

function persistCurrentOffset() {
  if (!state.currentMeta) {
    return false;
  }
  if (!state.overrides) {
    state.overrides = loadOverrides();
  }

  var entry = findOverride(state.currentMeta);
  if (!entry) {
    var lrclibId = state.currentLrclibId || sourceLrclibId(state.currentLyricsSource);
    if (!lrclibId) {
      return false;
    }
    entry = {
      title: state.currentMeta.title || "",
      artist: state.currentMeta.artist || "",
      album: state.currentMeta.album || "",
      duration: Math.round(toNumber(state.currentMeta.duration)),
      source: "lrclib",
      lrclibId: parseInt(lrclibId, 10),
      offsetSeconds: state.currentOffsetSeconds,
      updatedAt: new Date().toISOString()
    };
    state.overrides.tracks[makeTrackKey(state.currentMeta)] = entry;
  } else {
    entry.offsetSeconds = state.currentOffsetSeconds;
    entry.updatedAt = new Date().toISOString();
  }

  saveOverrides();
  return true;
}

function updateOffsetStatusLabel() {
  if (state.fields.offsetStatus) {
    state.fields.offsetStatus.setStringValue($(formatOffsetDescription(state.currentOffsetSeconds)));
  }
}

function formatOffsetSeconds(value) {
  var number = clampOffsetSeconds(value);
  if (Math.abs(number) < 0.05) {
    return "0";
  }
  return String(number);
}

function formatOffsetDescription(value) {
  var number = clampOffsetSeconds(value);
  if (Math.abs(number) < 0.05) {
    return "当前同步";
  }
  if (number > 0) {
    return "已提前 " + formatOffsetSeconds(number) + " 秒";
  }
  return "已延后 " + formatOffsetSeconds(Math.abs(number)) + " 秒";
}

function formatTrackTitle(meta, playbackState) {
  var title = meta && meta.title ? meta.title : PRODUCT_NAME;
  var artist = meta && meta.artist ? meta.artist : "";
  var prefix = playbackState === "paused" ? "暂停 · " : "";
  if (artist) {
    return prefix + title + " - " + artist;
  }
  return prefix + title;
}

function normalizeForKey(value) {
  return normalizeForCompare(value).replace(/\s+/g, "-") || "unknown";
}

function normalizeForCompare(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[\u2018\u2019]/g, "'")
    .replace(/[\u201c\u201d]/g, '"')
    .replace(/[^\w\u4e00-\u9fff]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function cleanTitleForMatch(title) {
  return String(title || "")
    .replace(/\s*[\(\[\{（【][^\)\]\}）】]*(live|remaster|remastered|feat\.?|featuring|version|edit|mono|stereo|explicit|deluxe|bonus|伴奏|翻唱|现场)[^\)\]\}）】]*[\)\]\}）】]\s*/ig, " ")
    .replace(/\s+-\s*(live|remaster(?:ed)?|radio edit|single version|album version).*$/ig, "")
    .replace(/\s+/g, " ")
    .trim();
}

function titleSearchCandidates(title) {
  var candidates = [];
  addUniqueTitle(candidates, title);
  addUniqueTitle(candidates, cleanTitleForMatch(title));

  var bracketRegex = /[\(\[\{（【]([^\)\]\}）】]+)[\)\]\}）】]/g;
  var match = null;
  while ((match = bracketRegex.exec(String(title || ""))) !== null) {
    var pieces = match[1].split(/[\/／|｜,，、;；]+/);
    for (var i = 0; i < pieces.length; i++) {
      var piece = cleanTitlePiece(pieces[i]);
      if (piece) {
        addUniqueTitle(candidates, piece);
      }
    }
  }

  return candidates;
}

function addUniqueTitle(candidates, value) {
  var text = String(value || "").replace(/\s+/g, " ").trim();
  if (!text) {
    return;
  }
  for (var i = 0; i < candidates.length; i++) {
    if (normalizeForCompare(candidates[i]) === normalizeForCompare(text)) {
      return;
    }
  }
  candidates.push(text);
}

function cleanTitlePiece(value) {
  var text = String(value || "")
    .replace(/\b(live|remaster(?:ed)?|feat\.?|featuring|version|edit|mono|stereo|explicit|deluxe|bonus)\b/ig, " ")
    .replace(/伴奏|翻唱|现场|纯音乐|无损|原版|新版/g, " ")
    .replace(/\s+/g, " ")
    .trim();
  if (normalizeForCompare(text).length < 2) {
    return "";
  }
  return text;
}

function splitArtists(artist) {
  var raw = String(artist || "");
  if (!raw) {
    return [];
  }
  var parts = raw.split(/\s*(?:,|，|、|\/|;|；|&|\band\b|\bfeat\.?\b|\bfeaturing\b)\s*/i);
  var cleaned = [];
  for (var i = 0; i < parts.length; i++) {
    var part = parts[i].trim();
    if (part && cleaned.indexOf(part) < 0) {
      cleaned.push(part);
    }
  }
  return cleaned;
}

function toNumber(value) {
  var number = parseFloat(value);
  if (isNaN(number)) {
    return 0;
  }
  return number;
}

function compact(value, maxLength) {
  var text = String(value || "");
  if (text.length <= maxLength) {
    return text;
  }
  return text.substring(0, maxLength - 1) + "…";
}

function runSelfTest() {
  ensureDataFiles();
  assert(hasArgument(["--self-test"], "--self-test"), "Command arguments should be detected");
  assert(!hasArgument({}, "--self-test"), "Non-array app launch arguments should be ignored");
  var sample = "[00:00.00]Intro\n[00:01.50]第一句\n[00:03.00][00:04.00]重复句";
  var lines = parseLrc(sample);
  assert(lines.length === 4, "LRC parser should support multiple timestamps");
  assert(findLyricLine(lines, 1.55) === "第一句", "Current lyric should match playback position");
  assert(findLyricLine(lines, 0.55, 1) === "第一句", "Positive offset should advance lyrics");
  assert(findLyricLine(lines, 2.55, -1) === "第一句", "Negative offset should delay lyrics");
  assert(findLyricLine(lines, 4.2) === "重复句", "Current lyric should match repeated timestamp");
  var bilingualLines = parseLrc("[00:01.00]I love you\n[00:01.00]我爱你\n[00:03.00]世界");
  assert(bilingualLines.length === 2, "Bilingual lines at the same timestamp should merge");
  assert(findLyricEntry(bilingualLines, 1.0).text === "I love you", "Original non-Chinese lyric should stay on top");
  assert(findLyricEntry(bilingualLines, 1.0).translation === "我爱你", "Chinese lyric should become translation");
  assert(shouldShowChineseTranslation("I love you", "我爱你"), "Non-Chinese lyrics should show Chinese translation");
  assert(shouldShowChineseTranslation("君を愛してる", "我爱你"), "Japanese lyrics should show Chinese translation");
  assert(shouldShowChineseTranslation("사랑해", "我爱你"), "Korean lyrics should show Chinese translation");
  assert(!shouldShowChineseTranslation("世界", "世界"), "Chinese lyrics should not duplicate translation");
  assert(normalizeForKey("Artist Name") === "artist-name", "Normalize key should be stable");
  assert(validMusicId("missing value") === "", "Missing Music IDs should not become track keys");
  assert(makeTrackFingerprint({
    title: "A",
    artist: "B",
    album: "",
    duration: 1,
    persistentId: "missing value"
  }) !== makeTrackFingerprint({
    title: "C",
    artist: "B",
    album: "",
    duration: 1,
    persistentId: "missing value"
  }), "Playback fingerprint should change when title changes without a usable Music ID");
  assert(
    titleSearchCandidates("解脱 (明明你先说爱我 / 伴奏)").indexOf("明明你先说爱我") >= 0,
    "Title aliases in brackets should be searchable"
  );
  var broadVariants = buildSearchVariants({
    title: "平行",
    artist: "张鑫",
    album: "不知道倦",
    duration: 249
  });
  assert(hasVariant(broadVariants, "平行", "张鑫", "", 0), "Search should fall back without album and duration");
  assert(hasVariant(broadVariants, "平行", "", "", 0), "Search should fall back to title-only lookup");
  assert(sourceLrclibId("lrclib:12345") === "12345", "LRCLIB source IDs should be reusable");
  assert(clampOffsetSeconds(130) === 120, "Offset should be clamped");
  assert(formatOffsetDescription(0) === "当前同步", "Zero offset should be described as synced");
  assert(formatOffsetDescription(0.5) === "已提前 0.5 秒", "Positive offset should be described as early");
  assert(formatOffsetDescription(-0.5) === "已延后 0.5 秒", "Negative offset should be described as delayed");
  assert(clampLyricFontSize(8) === 14, "Lyric font size should have a lower bound");
  assert(clampLyricFontSize(40) === 30, "Lyric font size should have an upper bound");
  assert(normalizeHexColor("0f0") === "#00FF00", "Short hex colors should be normalized");
  assert(normalizeHexColor("bad-color") === "#FFFFFF", "Invalid colors should fall back to white");
  assert(OVERRIDES_PATH.indexOf(".app/Contents/") < 0, "User data must not be stored inside the app bundle");
  JSON.parse(readTextFile(OVERRIDES_PATH));
  JSON.parse(readTextFile(SETTINGS_PATH));
  console.log("self-test passed");
}

function hasVariant(variants, title, artist, album, duration) {
  for (var i = 0; i < variants.length; i++) {
    var item = variants[i];
    if ((item.track_name || "") === title &&
      (item.artist_name || "") === artist &&
      (item.album_name || "") === album &&
      String(item.duration || "") === (duration ? String(duration) : "")) {
      return true;
    }
  }
  return false;
}

function runUiSmokeTest() {
  ensureDataFiles();
  state.overrides = loadOverrides();
  state.currentMeta = {
    title: "测试歌曲",
    artist: "测试歌手",
    album: "测试专辑",
    duration: 180,
    position: 0,
    persistentId: "ui-smoke",
    databaseId: ""
  };
  state.currentLrclibId = "12345";
  state.currentLyricsSource = "lrclib:12345";

  var nsApp = $.NSApplication.sharedApplication;
  nsApp.setActivationPolicy($.NSApplicationActivationPolicyAccessory);
  registerControllerClass();
  state.controller = $.LyricIslandController.alloc.init;
  createIslandWindow();
  createStatusMenu();
  renderStatus("测试歌曲 - 测试歌手", "这是一句用于检查窗口渲染的歌词");
  renderLyricEntry("测试歌曲 - 测试歌手", { time: 0, text: "I love you", translation: "我爱你" }, false);
  assert(!state.translationLabel.isHidden, "Translation label should be visible for bilingual lyrics");
  renderLyricEntry("测试歌曲 - 测试歌手", { time: 0, text: "中文歌词", translation: "中文歌词" }, false);
  assert(state.translationLabel.isHidden, "Translation label should stay hidden for Chinese lyrics");
  openCorrectionPanel();
  assert(!!state.statusItem, "Menu bar item should be created");
  assert(!!state.visibilityMenuItem, "Visibility menu item should be created");
  adjustCurrentOffset(0.5);
  assert(state.currentOffsetSeconds === 0.5, "Quick adjustment should advance lyrics");
  assert(fieldString("offsetStatus") === "已提前 0.5 秒", "Offset status should update without numeric input");
  assert(findOverride(state.currentMeta).offsetSeconds === 0.5, "Quick adjustment should persist automatically");
  setCurrentOffset(0);
  assert(state.currentOffsetSeconds === 0, "Quick adjustment should reset lyrics offset");
  toggleIslandVisibility();
  toggleIslandVisibility();
  if (state.correctionPanel) {
    state.correctionPanel.close;
  }
  if (state.window) {
    state.window.close;
  }
  if (state.statusItem) {
    $.NSStatusBar.systemStatusBar.removeStatusItem(state.statusItem);
  }
  console.log("ui-smoke passed");
}

function runLrclibSmokeTest() {
  var meta = {
    title: "Yellow",
    artist: "Coldplay",
    album: "Parachutes",
    duration: 267
  };
  var best = fetchLrclibExact(meta);
  if (!best || !best.syncedLyrics) {
    var candidates = searchLrclibCandidates(meta);
    best = chooseBestCandidate(meta, candidates);
  }
  assert(!!best, "LRCLIB should return a synced lyric candidate");
  var lines = parseLrc(best.syncedLyrics || "");
  assert(lines.length > 0, "Best LRCLIB candidate should contain parseable synced lyrics");
  console.log("lrclib-smoke passed: id=" + best.id + ", lines=" + lines.length);
}

function runMusicSmokeTest() {
  var snapshot = readMusicState();
  console.log(JSON.stringify(snapshot, null, 2));
}

function assert(condition, message) {
  if (!condition) {
    throw new Error(message);
  }
}
